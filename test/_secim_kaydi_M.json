[{"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Mantık", "adim": "2", "soru_no": "2", "cevap_anahtari": "D", "benim_cevabim": "D", "eslesti": "EVET", "soru_turu": "kavram", "isaret": "Koşullu önermenin karşıt tersi soruluyor", "ana_hamle": "karsit_ters_cevir_ve_degille", "ikinci_hamle": "", "tuzak_yanilgi": "Yalnız yer değiştirir ya da yalnız değil alır", "guven": "yüksek", "not": "p⇒q'nun karşıt tersi q'⇒p': \"4·3<12 ise 4+3≠7\"."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Mantık", "adim": "2", "soru_no": "4", "cevap_anahtari": "B", "benim_cevabim": "B", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "p⇒(q∨r) yanlış verilmiş; sıralama bulunacak", "ana_hamle": "kesin_deger_veren_baglactan_basla", "ikinci_hamle": "bulunan_degerlerle_yerlestir", "tuzak_yanilgi": "Yanlış koşulluda sonucun bileşenlerinden birini doğru bırakır", "guven": "yüksek", "not": "p=1, q∨r=0 → q=0, r=0. Üçüncü Ayça; birinci Emre değil, ikinci Pınar değil → Pınar, Emre, Ayça."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Kümeler", "adim": "1", "soru_no": "14", "cevap_anahtari": "A", "benim_cevabim": "A", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Fark kümeleri ve kümeler arasında katsayılı eşitlikler; B − A' soruluyor", "ana_hamle": "venn_bolgelerine_degisken_yaz", "ikinci_hamle": "", "tuzak_yanilgi": "B − A'nın B ∩ A olduğunu görmez", "guven": "yüksek", "not": "s(A−B)=x, s(B−A)=3x, kesişim k: 5(x+k) = 2(3x+k) → x = 3k. Birleşim 13k = 39 → k = 3. B − A' = A∩B = 3."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Kümeler", "adim": "3", "soru_no": "4", "cevap_anahtari": "D", "benim_cevabim": "D", "eslesti": "EVET", "soru_turu": "yargı", "isaret": "Eleman sayısı sabit kümeler; kelimelerin yazılabilmesi", "ana_hamle": "kalan_bos_yeri_say", "ikinci_hamle": "elemanlari_tek_tek_listele", "tuzak_yanilgi": "akademisyen'i kesişime koyup çelişkiyi görmez", "guven": "yüksek", "not": "akademisyen 9 farklı harf → kesişime giremez; asker ve ressam kesişimde: {a,e,k,m,r,s}. A'da 3 boş yer kalır; sanatçı 4 yeni harf ister → yazılamaz."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Temel Kavramlar, Sayı Basamakları, Sayı Kümeleri - 1", "adim": "2", "soru_no": "5", "cevap_anahtari": "D", "benim_cevabim": "D", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Çerçevede sayılar, her satır/sütun toplamı eşit, köşeler soruluyor", "ana_hamle": "ortak_sayilani_bir_kez_cikar", "ikinci_hamle": "", "tuzak_yanilgi": "Köşelerin iki kez sayıldığını görmez", "guven": "yüksek", "not": "Dört kenar toplamı 4·22 = 88 = 1+…+12 (78) + köşeler → köşeler 10."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Temel Kavramlar, Sayı Basamakları, Sayı Kümeleri - 1", "adim": "3", "soru_no": "9", "cevap_anahtari": "E", "benim_cevabim": "E", "eslesti": "EVET", "soru_turu": "yargı", "isaret": "Üç ifadeden ikisi tek, biri çift", "ana_hamle": "tek_cift_tablosuyla_dene", "ikinci_hamle": "", "tuzak_yanilgi": "Katsayıların paritesini sadeleştirmez", "guven": "yüksek", "not": "Mod 2: a + 5b ≡ a + b, 3a + b ≡ a + b, 2a + 3b ≡ b. İkisi aynı olduğundan a + b tek, b çift → a tek. 2a + b ve ab çift."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Temel Kavramlar, Sayı Basamakları, Sayı Kümeleri - 2", "adim": "1", "soru_no": "11", "cevap_anahtari": "C", "benim_cevabim": "C", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Daire içindeki sayı 0,a olarak tanımlı; kesir işlemi", "ana_hamle": "yeni_islemi_kuralina_gore_uygula", "ikinci_hamle": "ondaligi_kesre_cevir", "tuzak_yanilgi": "0,5/0,4'ü 0,125 sanır", "guven": "yüksek", "not": "0,5/0,4 − 0,4/0,3 = 5/4 − 4/3 = −1/12."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Temel Kavramlar, Sayı Basamakları, Sayı Kümeleri - 2", "adim": "2", "soru_no": "8", "cevap_anahtari": "C", "benim_cevabim": "C", "eslesti": "EVET", "soru_turu": "yargı", "isaret": "Kız-erkek sayılarıyla tam sayılı denklem; parite yargıları", "ana_hamle": "tam_sayi_cozumleri_listele", "ikinci_hamle": "tek_cift_tablosuyla_dene", "tuzak_yanilgi": "Tek bir çözüm bulup onu kesin sanır", "guven": "yüksek", "not": "6a + 5b = 100 → (15, 2), (10, 8), (5, 14). b hep çift, ab hep çift; a bazen çift → II ve IV."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Temel Kavramlar, Sayı Basamakları, Sayı Kümeleri - 2", "adim": "3", "soru_no": "8", "cevap_anahtari": "C", "benim_cevabim": "C", "eslesti": "EVET", "soru_turu": "yargı", "isaret": "İki yükseklik arasındaki fark, sonra ağacın iki katı", "ana_hamle": "durumlari_ikiye_ayir", "ikinci_hamle": "mutlak_degeri_iki_durumda_coz", "tuzak_yanilgi": "Farkın hangi yönde olduğunu tek yönlü alır", "guven": "yüksek", "not": "B = T + 8: 8 − T = ±3 → T = 5 ya da 11 → B = 13 ya da 19. B = T − 8 çözüm vermez."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Bölme - Bölünebilme Kuralları", "adim": "2", "soru_no": "7", "cevap_anahtari": "D", "benim_cevabim": "D", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "45'e bölümden kalan; dört basamaklı sayı", "ana_hamle": "bolunebilme_kurallarini_birlestir", "ikinci_hamle": "rakam_toplamindan_kalan_bul", "tuzak_yanilgi": "9'a kalanı 11 alır", "guven": "yüksek", "not": "5'e kalan 1 → B ∈ {1, 6}; 9'a kalan 2 → A + B ≡ 1 → B = 1: A ∈ {0, 9}; B = 6: A = 4 → 13."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Bölme - Bölünebilme Kuralları", "adim": "2", "soru_no": "11", "cevap_anahtari": "C", "benim_cevabim": "C", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Her hafta sabit birikim; eksik miktar ve fiyatın rakam biçimi", "ana_hamle": "bolunen_bolen_bolum_kalan_yaz", "ikinci_hamle": "en_buyuk_icin_uclari_dene", "tuzak_yanilgi": "Eksik kalan haftayı eklemeyi unutur", "guven": "yüksek", "not": "Fiyat 36w + 25 = 2a4b → w = 56 için 2041. Eksik 25 TL için bir hafta daha → 57."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Bölme - Bölünebilme Kuralları", "adim": "3", "soru_no": "9", "cevap_anahtari": "D", "benim_cevabim": "D", "eslesti": "EVET", "soru_turu": "yargı", "isaret": "Koltuk genişliği ve iki kenar boşluğu; toplam genişliğin kalanları", "ana_hamle": "kalanli_ifadeyi_yerine_koy", "ikinci_hamle": "", "tuzak_yanilgi": "Kenar boşluğunu tek kez ekler", "guven": "yüksek", "not": "A = 60k + 160. 3'e kalan 1 (I yanlış), 12'ye kalan 4, 15'e kalan 10."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "EBOB - EKOK, Periyodik Olarak Tekrar Eden Durumlar", "adim": "2", "soru_no": "4", "cevap_anahtari": "A", "benim_cevabim": "A", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "İki rulo eşit uzunlukta; parça boyları farklı; üst sınır", "ana_hamle": "ekok_ile_ortak_kat", "ikinci_hamle": "en_buyuk_icin_uclari_dene", "tuzak_yanilgi": "B markasını da hesaba katıp küçük olanı seçer", "guven": "yüksek", "not": "Uzunluk 12 ve 18'in katı → 36'nın katı, 500'den küçük → 468. A ile 468/12 = 39 müşteri."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "EBOB - EKOK, Periyodik Olarak Tekrar Eden Durumlar", "adim": "2", "soru_no": "9", "cevap_anahtari": "A", "benim_cevabim": "A", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Faktöriyelli iki sayının EKOK/EBOB oranı", "ana_hamle": "ortak_carpan_paranteze_al", "ikinci_hamle": "ebob_kucuk_us_ekok_buyuk_us", "tuzak_yanilgi": "Faktöriyelleri açıp büyük sayılarla uğraşır", "guven": "yüksek", "not": "A = 6!·6, B = 6!·8 → EBOB = 6!·2, EKOK = 6!·24 → 12."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Birinci Dereceden Denklem ve Eşitsizlikler - 1", "adim": "2", "soru_no": "2", "cevap_anahtari": "A", "benim_cevabim": "A", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "İki aşamalı satış, kalanlar arasında oranlar, toplam satış", "ana_hamle": "hepsini_tek_bazla_zincirle", "ikinci_hamle": "tam_sayi_cozumleri_listele", "tuzak_yanilgi": "Kalanların tam sayı olma koşulunu kullanmaz", "guven": "yüksek", "not": "Sarı s: satılan sarı 5s/6, mavi satış 30 − 5s/6. Başlangıç 30 + 2s/3, s 6'nın katı ve 36'dan küçük → 34, 38, 42, 46, 50 → 50."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Birinci Dereceden Denklem ve Eşitsizlikler - 2", "adim": "1", "soru_no": "12", "cevap_anahtari": "C", "benim_cevabim": "C", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Taban ortak iki bölme; hacim karşılaştırması", "ana_hamle": "esitsizlikleri_zincirle_aralik_bul", "ikinci_hamle": "", "tuzak_yanilgi": "Ortak tabanı sadeleştirmeden alan hesaplamaya çalışır", "guven": "yüksek", "not": "Hacim oranı yükseklik oranı: 3x + 3 > 2(x + 3) → x > 3 → 3x + 3 > 12 → 13."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Birinci Dereceden Denklem ve Eşitsizlikler - 2", "adim": "2", "soru_no": "7", "cevap_anahtari": "B", "benim_cevabim": "B", "eslesti": "EVET", "soru_turu": "yargı", "isaret": "Aralıklardaki x, y ile işaret ve en küçük değer yargıları", "ana_hamle": "isaret_tablosuyla_karar_ver", "ikinci_hamle": "pozitif_araliklari_uca_uca_carp", "tuzak_yanilgi": "III'te aralığın en küçük tam sayısını alt sınırı yerine üst sınırı sanır", "guven": "yüksek", "not": "I: x < 0 < y doğru. II: iki negatif çarpımı pozitif. III: 0 < 2x² + 3y < 8 → en küçük tam değer 1."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Birinci Dereceden Denklem ve Eşitsizlikler - 2", "adim": "3", "soru_no": "8", "cevap_anahtari": "D", "benim_cevabim": "D", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Yedi sayı, beşi toplanıyor ikisi çıkarılıyor", "ana_hamle": "toplami_once_bul", "ikinci_hamle": "", "tuzak_yanilgi": "Çıkarılan sayıların iki kez etkilediğini unutur", "guven": "yüksek", "not": "Hepsinin toplamı 42; 42 − 2(m + n) = 10 → m + n = 16 → 7 ve 9 → 63."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Mutlak Değer", "adim": "1", "soru_no": "16", "cevap_anahtari": "A", "benim_cevabim": "A", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Çok büyük sayıya eşit mutlak değer; kökler toplamı", "ana_hamle": "kokler_simetrik_merkezin_iki_kati", "ikinci_hamle": "", "tuzak_yanilgi": "2022!'i hesaplamaya çalışır", "guven": "yüksek", "not": "Kökler −7 etrafında simetrik → toplam −14."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Mutlak Değer", "adim": "3", "soru_no": "4", "cevap_anahtari": "A", "benim_cevabim": "A", "eslesti": "EVET", "soru_turu": "kavram", "isaret": "Atlamadan sonra paraşüt açma mesafesi; yerden yükseklik", "ana_hamle": "merkez_ve_yaricapla_yaz", "ikinci_hamle": "bilinen_parcalari_cikar", "tuzak_yanilgi": "Açma mesafesini yükseklik sanır", "guven": "yüksek", "not": "800 − [400, 500] = [300, 400] → |x − 350| ≤ 50."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Üslü ve Köklü İfadeler - 1", "adim": "1", "soru_no": "9", "cevap_anahtari": "A", "benim_cevabim": "A", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Okul, sınıf, öğrenci sayıları 2'nin kuvvetleri", "ana_hamle": "tabanlari_asallara_ayir", "ikinci_hamle": "", "tuzak_yanilgi": "Üsleri çarpar", "guven": "yüksek", "not": "2^8·2^5·2^4·2 = 2^18."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Üslü ve Köklü İfadeler - 1", "adim": "2", "soru_no": "8", "cevap_anahtari": "C", "benim_cevabim": "C", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Her adımda üçgen sayısı ve içteki sayı ikiye katlanıyor", "ana_hamle": "kucuk_n_ile_deseni_bul", "ikinci_hamle": "tabanlari_asallara_ayir", "tuzak_yanilgi": "Yalnız içteki sayıyı ya da yalnız adedi alır", "guven": "yüksek", "not": "n. adımda 2^(n−1) üçgen, içinde 2^n → 2^(2n−1); n = 10 → 2^19."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Üslü ve Köklü İfadeler - 2", "adim": "1", "soru_no": "12", "cevap_anahtari": "A", "benim_cevabim": "A", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "İki üslü ifadenin toplamı ve farkı", "ana_hamle": "denklemleri_taraf_tarafa_topla", "ikinci_hamle": "ussu_degiskene_cevir", "tuzak_yanilgi": "x ve y'yi ayrı bulmaya çalışır", "guven": "yüksek", "not": "9^x = 36, 9^y = 25 → 9^(x+y) = 900 → 3^(x+y) = 30."}, {"kaynak": "MEB 3 Adım TYT Matematik", "unite": "Üslü ve Köklü İfadeler - 2", "adim": "3", "soru_no": "8", "cevap_anahtari": "C", "benim_cevabim": "C", "eslesti": "EVET", "soru_turu": "sayısal", "isaret": "Yol boyunca parça u